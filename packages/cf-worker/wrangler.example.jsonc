{
  // Copy to wrangler.local.jsonc or inject CLOUDFLARE_ACCOUNT_ID via CI environment variables.
  // Never commit wrangler.release.json or hardcoded account_id values.
  "name": "cardz-public-mcp",
  "main": "build/worker.js",
  "compatibility_date": "2026-05-22",
  "workers_dev": false,
  "routes": [
    { "pattern": "mcp.cardz.game", "custom_domain": true }
  ],
  "preview_urls": false,
  "send_metrics": false,
  "observability": { "enabled": false },
  "vars": {
    "PUBLIC_MCP_ENABLED": "false",
    "API_BASE_URL": "https://api.cardzmarketcap.com",
    "ALLOWED_ORIGINS": "https://platform.openai.com,https://chatgpt.com,https://claude.ai,https://cursor.com"
  },
  "ratelimits": [
    { "name": "CLIENT_LIMITER", "namespace_id": "2001", "simple": { "limit": 60, "period": 60 } },
    { "name": "SERVICE_LIMITER", "namespace_id": "2002", "simple": { "limit": 2400, "period": 60 } }
  ]
}
