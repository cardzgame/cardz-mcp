{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.cardz.game/mcp/v2/evaluate-portfolio.schema.json",
  "input": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "required": ["items"],
    "additionalProperties": false,
    "properties": {
      "items": {
        "type": "array",
        "minItems": 1,
        "maxItems": 50,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "itemRef": { "type": "string", "maxLength": 64 },
            "cardId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 96,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
            },
            "externalId": {
              "type": "string",
              "minLength": 3,
              "maxLength": 160,
              "pattern": "^(?:jlp_standard|tcgplayer|snkrdunk|pricecharting|cmc|psa_spec|official_dex):[A-Za-z0-9][A-Za-z0-9_./\\[\\] -]{0,127}$",
              "description": "Namespaced public external ID (e.g. 'tcgplayer:518881', 'snkrdunk:102424')."
            },
            "jlpName": {
              "type": "string",
              "minLength": 3,
              "maxLength": 200,
              "description": "JLP standard card alias (e.g. '2023 Pikachu [SV2a 025/165] JP')."
            },
            "name": { "type": "string", "minLength": 1, "maxLength": 200 },
            "collectorNumber": { "type": "string", "maxLength": 32 },
            "setName": { "type": "string", "maxLength": 100 },
            "tcg": {
              "type": "string",
              "enum": ["pokemon", "one-piece", "kpop", "sports", "naruto"]
            },
            "cardLanguage": {
              "type": "string",
              "enum": ["en", "ja", "zh", "ko"]
            },
            "grade": {
              "type": "string",
              "enum": ["PSA10", "PSA9", "PSA8", "BGS10", "BGS9.5", "CGC10", "RAW"],
              "default": "PSA10"
            },
            "quantity": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10000,
              "default": 1
            },
            "buyPriceUsd": {
              "type": "number",
              "minimum": 0,
              "maximum": 100000000
            },
            "acquiredAt": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            }
          },
          "anyOf": [
            { "required": ["cardId"], "properties": { "cardId": { "type": "string", "minLength": 1 } } },
            { "required": ["externalId"], "properties": { "externalId": { "type": "string", "minLength": 3 } } },
            { "required": ["jlpName"], "properties": { "jlpName": { "type": "string", "minLength": 3 } } },
            { "required": ["name"], "properties": { "name": { "type": "string", "minLength": 1 } } },
            { "required": ["collectorNumber"], "properties": { "collectorNumber": { "type": "string", "minLength": 1 } } }
          ]
        }
      },
      "lang": {
        "type": "string",
        "enum": ["en", "zh-TW", "ja", "ko"],
        "default": "en"
      },
      "pricePreference": {
        "type": "string",
        "enum": ["verified_first", "verified_only"],
        "default": "verified_first"
      }
    }
  },
  "output": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "required": [
      "source", "currency", "evaluatedAt", "pricePreference",
      "summary", "positions", "disambiguationRequired", "disclaimer"
    ],
    "properties": {
      "source": { "type": "string", "const": "CardZ Marketcap" },
      "currency": { "type": "string", "const": "USD" },
      "evaluatedAt": { "type": "string", "format": "date-time" },
      "pricePreference": { "type": "string", "enum": ["verified_first", "verified_only"] },
      "summary": {
        "type": "object",
        "required": [
          "totalItemsSubmitted", "pricedItemsCount", "ambiguousItemsCount",
          "unmatchedItemsCount", "unpricedItemsCount", "valuationCoveragePct",
          "totalMarketValueUsd", "totalCostBasisUsd",
          "totalUnrealizedPnlUsd", "totalUnrealizedPnlPct"
        ],
        "properties": {
          "totalItemsSubmitted": { "type": "integer", "minimum": 1, "maximum": 50 },
          "pricedItemsCount": { "type": "integer", "minimum": 0 },
          "ambiguousItemsCount": { "type": "integer", "minimum": 0 },
          "unmatchedItemsCount": { "type": "integer", "minimum": 0 },
          "unpricedItemsCount": { "type": "integer", "minimum": 0 },
          "valuationCoveragePct": { "type": "number", "minimum": 0, "maximum": 100 },
          "totalMarketValueUsd": { "type": ["number", "null"] },
          "totalCostBasisUsd": { "type": ["number", "null"] },
          "totalUnrealizedPnlUsd": { "type": ["number", "null"] },
          "totalUnrealizedPnlPct": { "type": ["number", "null"] },
          "referencePricedItemsCount": { "type": "integer", "minimum": 0 }
        }
      },
      "positions": {
        "type": "array",
        "items": {
          "type": "object",
          "required": ["index", "status", "grade", "quantity"],
          "properties": {
            "index": { "type": "integer", "minimum": 0 },
            "itemRef": { "type": ["string", "null"] },
            "status": {
              "type": "string",
              "enum": ["matched_priced", "matched_unpriced", "ambiguous", "not_found"]
            },
            "resolvedFrom": {
              "type": ["string", "null"],
              "enum": ["canonical_id", "external_identity", "jlp_standard", "multilingual_alias", "fuzzy_clue", null]
            },
            "grade": { "$ref": "common.schema.json#/$defs/GradeCode" },
            "quantity": { "type": "integer", "minimum": 1 },
            "matchedCard": {
              "type": ["object", "null"],
              "properties": {
                "id": { "$ref": "common.schema.json#/$defs/CardId" },
                "name": { "type": "string" },
                "collectorNumber": { "type": ["string", "null"] },
                "setName": { "type": ["string", "null"] },
                "tcg": { "type": "string" },
                "cardLanguage": { "type": ["string", "null"] },
                "jlpStandardName": { "type": ["string", "null"] },
                "url": { "type": "string", "format": "uri" }
              }
            },
            "unitMarketPriceUsd": { "type": ["number", "null"] },
            "priceBasis": { "$ref": "common.schema.json#/$defs/PriceBasis" },
            "priceAsOf": { "type": ["string", "null"], "format": "date-time" },
            "positionMarketValueUsd": { "type": ["number", "null"] },
            "unitBuyPriceUsd": { "type": ["number", "null"] },
            "positionCostBasisUsd": { "type": ["number", "null"] },
            "unrealizedPnlUsd": { "type": ["number", "null"] },
            "unrealizedPnlPct": { "type": ["number", "null"] },
            "crossMarketQuotes": {
              "type": "array",
              "maxItems": 4,
              "items": { "$ref": "common.schema.json#/$defs/CrossMarketRegionQuote" }
            },
            "message": { "type": ["string", "null"] },
            "candidates": {
              "type": "array",
              "maxItems": 5,
              "items": {
                "type": "object",
                "required": ["id", "name", "collectorNumber", "setName", "cardLanguage", "tcg", "url"],
                "properties": {
                  "id": { "$ref": "common.schema.json#/$defs/CardId" },
                  "name": { "type": "string" },
                  "collectorNumber": { "type": ["string", "null"] },
                  "setName": { "type": ["string", "null"] },
                  "cardLanguage": { "type": ["string", "null"] },
                  "tcg": { "type": "string" },
                  "jlpStandardName": { "type": ["string", "null"] },
                  "url": { "type": "string", "format": "uri" },
                  "referencePriceUsd": { "type": ["number", "null"] }
                }
              }
            }
          }
        }
      },
      "disambiguationRequired": { "type": "boolean" },
      "disclaimer": { "type": "string" }
    }
  }
}
