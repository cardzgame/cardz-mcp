{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.cardz.game/registry/v1/exchange-onboarding.schema.json",
  "type": "object",
  "required": [
    "schemaVersion", "exchangeSlug", "displayName", "websiteUrl",
    "operatingRegions", "settlementCurrencies", "supportedIps", "supportedGrades",
    "dataFeed", "integrityControls", "sampleTransactions", "contactEmail", "submittedAt"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0.0" },
    "exchangeSlug": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,40}$" },
    "displayName": { "type": "string", "minLength": 2, "maxLength": 80 },
    "websiteUrl": { "type": "string", "format": "uri", "pattern": "^https://" },
    "operatingRegions": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^[A-Z]{2}$" }
    },
    "settlementCurrencies": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^[A-Z]{3}$" }
    },
    "supportedIps": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "enum": ["pokemon", "one-piece", "kpop", "sports", "naruto", "other"] }
    },
    "supportedGrades": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "enum": ["PSA10", "PSA9", "PSA8", "BGS10", "BGS9.5", "CGC10", "RAW"] }
    },
    "dataFeed": {
      "type": "object",
      "required": [
        "feedType", "providesVerifiedSold", "providesOrderBook",
        "supportsIncrementalCursor", "hasStableTransactionId",
        "bestOfferReportsActualPaid", "separatesShippingFee", "docsUrl"
      ],
      "additionalProperties": false,
      "properties": {
        "feedType": { "type": "string", "enum": ["rest_api", "graphql", "daily_jsonl_dump", "webhook_plus_replay"] },
        "providesVerifiedSold": { "type": "boolean" },
        "providesOrderBook": { "type": "boolean" },
        "supportsIncrementalCursor": { "type": "boolean" },
        "hasStableTransactionId": { "type": "boolean" },
        "bestOfferReportsActualPaid": { "type": "boolean" },
        "separatesShippingFee": { "type": "boolean" },
        "supportsRetractionEvents": { "type": "boolean" },
        "docsUrl": { "type": "string", "format": "uri", "pattern": "^https://" },
        "authType": { "type": "string", "enum": ["public_noauth", "api_key_header", "oauth2_client_credentials"] },
        "estimatedDailyVolumeUsd": { "type": "number", "minimum": 0 }
      }
    },
    "integrityControls": {
      "type": "object",
      "required": ["antiWashTradingSummary", "includesPii"],
      "additionalProperties": false,
      "properties": {
        "antiWashTradingSummary": { "type": "string", "minLength": 20, "maxLength": 1500 },
        "includesPii": { "type": "boolean", "const": false }
      }
    },
    "sampleTransactions": {
      "type": "array",
      "minItems": 5,
      "maxItems": 50,
      "items": {
        "type": "object",
        "required": ["txId", "soldAt", "ip", "cardTitle", "collectorNumber", "cardLanguage", "grade", "priceAmount", "currency"],
        "additionalProperties": false,
        "properties": {
          "txId": { "type": "string", "minLength": 1, "maxLength": 128 },
          "soldAt": { "type": "string", "format": "date-time" },
          "ip": { "type": "string" },
          "cardTitle": { "type": "string", "maxLength": 200 },
          "collectorNumber": { "type": "string", "maxLength": 32 },
          "cardLanguage": { "type": "string", "enum": ["en", "ja", "zh", "ko"] },
          "grade": { "type": "string", "enum": ["PSA10", "PSA9", "PSA8", "BGS10", "BGS9.5", "CGC10", "RAW"] },
          "priceAmount": { "type": "number", "exclusiveMinimum": 0 },
          "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
          "shippingAmount": { "type": ["number", "null"], "minimum": 0 },
          "listingUrl": { "type": "string", "format": "uri", "pattern": "^https://" }
        }
      }
    },
    "contactEmail": { "type": "string", "format": "email" },
    "submittedAt": { "type": "string", "format": "date-time" }
  }
}
