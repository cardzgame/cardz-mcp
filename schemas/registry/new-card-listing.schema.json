{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.cardz.game/registry/v1/new-card-listing.schema.json",
  "type": "object",
  "required": [
    "schemaVersion", "listingId", "ip", "setCode", "setName",
    "collectorNumber", "cardLanguage", "finishVariant", "officialName",
    "releaseDate", "evidenceUrls", "submittedAt"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0.0" },
    "listingId": { "type": "string", "pattern": "^lst-[a-z0-9-]+-[a-z0-9]{4,12}$" },
    "ip": { "type": "string", "enum": ["pokemon", "one-piece", "kpop", "sports", "naruto", "other"] },
    "otherIpName": { "type": "string", "maxLength": 80 },
    "setCode": { "type": "string", "minLength": 1, "maxLength": 48, "pattern": "^[A-Za-z0-9._-]+$" },
    "setName": {
      "type": "object",
      "required": ["en"],
      "additionalProperties": false,
      "properties": {
        "en": { "type": "string", "minLength": 1, "maxLength": 160 },
        "zh-TW": { "type": "string", "maxLength": 160 },
        "ja": { "type": "string", "maxLength": 160 },
        "ko": { "type": "string", "maxLength": 160 }
      }
    },
    "collectorNumber": { "type": "string", "minLength": 1, "maxLength": 32 },
    "cardLanguage": { "type": "string", "enum": ["en", "ja", "zh", "ko"] },
    "finishVariant": {
      "type": "string",
      "enum": [
        "standard", "holo", "reverse_holo", "alt_art", "parallel",
        "manga_rare", "promo", "autograph", "numbered_patch"
      ]
    },
    "officialName": { "type": "string", "minLength": 1, "maxLength": 200 },
    "localizedNames": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "en": { "type": "string", "maxLength": 200 },
        "zh-TW": { "type": "string", "maxLength": 200 },
        "ja": { "type": "string", "maxLength": 200 },
        "ko": { "type": "string", "maxLength": 200 }
      }
    },
    "releaseDate": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "externalIdentifiers": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "officialDexOrProductCode": { "type": "string", "maxLength": 64 },
        "psaCertSample": { "type": "string", "pattern": "^[0-9]{6,12}$" },
        "cgcCertSample": { "type": "string", "pattern": "^[0-9]{6,14}$" }
      }
    },
    "artwork": {
      "type": "object",
      "required": ["relativePath", "sha256", "widthPx", "heightPx", "watermarkFreeDeclared"],
      "additionalProperties": false,
      "properties": {
        "relativePath": { "type": "string", "pattern": "^\\./[a-z0-9._-]+\\.(webp|png)$" },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "widthPx": { "type": "integer", "minimum": 400, "maximum": 2400 },
        "heightPx": { "type": "integer", "minimum": 500, "maximum": 3400 },
        "watermarkFreeDeclared": { "type": "boolean", "const": true }
      }
    },
    "evidenceUrls": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": { "type": "string", "format": "uri", "pattern": "^https://" }
    },
    "submittedAt": { "type": "string", "format": "date-time" }
  }
}
